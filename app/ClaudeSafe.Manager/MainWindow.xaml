<Window x:Class="ClaudeSafe.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ClaudeSafe.Manager">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent" Padding="18,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE83D;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="ClaudeSafe" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="专用通道管理器" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="True" PaneDisplayMode="Auto"
            OpenPaneLength="208" CompactModeThresholdWidth="860" ExpandedModeThresholdWidth="1120"
            IsBackButtonVisible="Collapsed" SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ChannelItem" Content="专用通道" Tag="channel"><NavigationViewItem.Icon><FontIcon Glyph="&#xE968;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="SubscriptionsItem" Content="订阅管理" Tag="subscriptions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="BenchmarksItem" Content="Desktop 测速" Tag="benchmarks"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Padding="16,12" Spacing="5">
                    <TextBlock x:Name="TrayState" Text="内核已停止" FontSize="12"/>
                    <TextBlock Text="关闭窗口后继续托盘运行" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid Padding="28,12,28,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Spacing="4" Margin="0,0,0,20">
                    <TextBlock x:Name="PageTitle" Text="专用通道" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock x:Name="PageSubtitle" Text="管理 Claude 的独立连接，选择你已批准的节点。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <local:ChannelView x:Name="Channel"/>
                    <local:SubscriptionsView x:Name="Subscriptions" Visibility="Collapsed"/>
                    <local:BenchmarksView x:Name="Benchmarks" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="Settings" Visibility="Collapsed">
                        <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Left">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <ComboBox x:Name="ThemeChoice" Header="应用主题" Width="260" SelectedIndex="0" SelectionChanged="OnThemeChanged" AutomationProperties.Name="应用主题">
                                        <ComboBoxItem Content="跟随 Windows"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
                                    </ComboBox>
                                    <TextBlock Text="系统支持时使用 Mica 背景；Windows 10 和高对比度模式使用系统背景色。" Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="连接与运行" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBlock Text="每次启动内核先进入 REJECT，选择已批准节点后才建立专用连接。自动切换默认关闭，可在 Desktop 测速中配置。" TextWrapping="Wrap"/>
                                    <TextBlock Text="关闭窗口会保留托盘；选择“停止内核并退出”结束管理器及其专用内核。" TextWrapping="Wrap"/>
                                    <Button Content="停止内核并退出" Click="OnExitClicked" AutomationProperties.Name="停止内核并退出"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="系统保护" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBlock Text="管理器不修改系统代理、TUN 或已有 WFP / AppLocker 规则。系统断网保护与升级门禁需独立维护。" TextWrapping="Wrap"/>
                                    <TextBlock Text="Windows 10 22H2 / Windows 11 · x64" Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
        <InfoBar x:Name="Status" Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="正在读取本机配置…" Margin="12,0,12,8"/>
    </Grid>
</Window>
